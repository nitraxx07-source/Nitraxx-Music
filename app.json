{
  "expo": {
    "name": "Nitraxx Music",
    "slug": "nitraxx-music",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#021217",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#021217"
    },
    "plugins": [
      "expo-av",
      "expo-file-system",
      "expo-sqlite"
    ],
    "android": {
      "package": "com.nitraxx.music.player",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#021217"
      }
    },
    "extra": {
      "eas": {
        "projectId": "3b0f5b98-3fb9-459f-832e-70881878b5f3"
      }
    }
  }
}
